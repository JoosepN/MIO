---
layout: base.njk
title: "Image Optimizer | Joosep Noorväli"
description: "Make a whole batch of images smaller in your browser. No limits, and nothing is uploaded."
activePage: "tools"
bodyClass: "bg-zinc-100 text-zinc-800 font-sans antialiased text-base min-h-screen flex flex-col"
permalink: /tools/image-optimizer/
---
<style>
    .tool-focus:focus-visible, .tool-choice input:focus-visible + span {
        outline: 2px solid var(--color-zinc-900);
        outline-offset: 2px;
    }
    #drop[data-over="true"] { border-color: var(--color-zinc-900); background: var(--color-zinc-50); }
    .tool-choice input:checked + span { background: var(--color-black); color: var(--color-white); border-color: var(--color-black); }
    [hidden] { display: none !important; }
    #progress { appearance: none; width: 100%; height: 8px; border: 0; border-radius: 999px; overflow: hidden; background: var(--color-zinc-200); }
    #progress::-webkit-progress-bar { background: var(--color-zinc-200); }
    #progress::-webkit-progress-value { background: var(--color-black); transition: width .2s ease; }
    #progress::-moz-progress-bar { background: var(--color-black); }
    #overwrite::backdrop, #compare::backdrop { background: rgb(0 0 0 / .6); }
    #compare { width: min(1100px, calc(100vw - 2rem)); max-width: none; }
    #compare-frame { position: relative; height: min(70vh, 760px); overflow: hidden; border-radius: 12px; background: var(--color-zinc-200); touch-action: none; user-select: none; cursor: ew-resize; }
    #compare-frame[data-zoom="actual"] { cursor: grab; }
    #compare-frame[data-zoom="actual"][data-dragging="true"] { cursor: grabbing; }
    #compare-frame:focus-visible, #compare-handle:focus-visible { outline: 2px solid var(--color-zinc-900); outline-offset: 2px; }
    #compare-stage { position: absolute; left: 0; top: 0; transform-origin: 0 0; }
    #compare-stage img { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; pointer-events: none; }
    #compare-handle { position: absolute; top: 0; bottom: 0; width: 44px; margin-left: -22px; cursor: ew-resize; }
    #compare-handle::before { content: ""; position: absolute; top: 0; bottom: 0; left: 21px; width: 2px; background: #fff; box-shadow: 0 0 0 1px rgb(0 0 0 / .35); }
    #compare-handle::after { content: "↔"; position: absolute; top: 50%; left: 50%; width: 36px; height: 36px; margin: -18px 0 0 -18px; border-radius: 999px; background: #fff; color: #000; box-shadow: 0 1px 4px rgb(0 0 0 / .4); display: flex; align-items: center; justify-content: center; font-size: 18px; }
    .compare-label { position: absolute; bottom: 10px; padding: 3px 8px; border-radius: 6px; background: rgb(0 0 0 / .72); color: #fff; font-size: 12px; font-variant-numeric: tabular-nums; pointer-events: none; }
    #rows td:first-child { min-width: 10rem; }
    @media (max-width: 639px) { #compare-label-before { bottom: auto; top: 10px; } }
    #compare-status { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: var(--color-zinc-700); font-size: 14px; }
    @media (prefers-reduced-motion: reduce) { #progress::-webkit-progress-value { transition: none; } }
</style>

<main class="flex-grow">
    <section class="pt-12 md:pt-20 pb-6 md:pb-10">
        <div class="max-w-4xl mx-auto px-4 sm:px-6">
            <h1 class="text-3xl md:text-5xl font-bold text-zinc-900 tracking-tight leading-tight">Image Optimizer</h1>
            <p class="mt-3 text-lg text-zinc-600 max-w-2xl">Make a whole batch of images smaller, tuned for the web. No limits, and everything runs in your browser, so nothing is uploaded.</p>
        </div>
    </section>

    <section class="pb-16">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 flex flex-col gap-4">

            <div id="drop" data-over="false" class="rounded-2xl border-2 border-dashed border-zinc-400 bg-white px-6 py-12 text-center transition-colors">
                <p class="text-lg font-medium text-zinc-900">Drop images or folders here</p>
                <p class="mt-1 text-sm text-zinc-600">JPEG, PNG, WebP, HEIC, AVIF and BMP. Folder structure is kept.</p>
                <div class="mt-5 flex flex-wrap justify-center gap-2">
                    <label class="tool-focus inline-flex cursor-pointer items-center rounded-full border border-zinc-500 px-4 py-2 text-sm font-medium text-zinc-900 hover:bg-zinc-100 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-zinc-900">
                        Choose files
                        <input id="pick-files" type="file" multiple class="sr-only">
                    </label>
                    <label class="tool-focus inline-flex cursor-pointer items-center rounded-full border border-zinc-500 px-4 py-2 text-sm font-medium text-zinc-900 hover:bg-zinc-100 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-zinc-900">
                        Choose folder
                        <input id="pick-folder" type="file" webkitdirectory class="sr-only">
                    </label>
                </div>
                <p class="mt-4 flex items-center justify-center gap-3 text-sm text-zinc-700" aria-live="polite">
                    <span id="file-count"></span>
                    <button id="clear" type="button" hidden class="tool-focus rounded underline underline-offset-2">Clear</button>
                </p>
            </div>

            <div class="rounded-2xl bg-white p-6 grid gap-6 md:grid-cols-2">
                <fieldset>
                    <legend class="text-sm font-semibold text-zinc-900">Resize <span class="font-normal text-zinc-600">(optional)</span></legend>
                    <div class="mt-3 flex gap-3">
                        <label class="flex-1 text-sm text-zinc-700">Max width
                            <span class="mt-1 flex items-center rounded-lg border border-zinc-500 bg-white focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-zinc-900">
                                <input id="width" type="number" min="1" inputmode="numeric" class="w-full min-w-0 bg-transparent px-3 py-2 text-zinc-900 outline-none">
                                <span class="pr-3 text-zinc-600">px</span>
                            </span>
                        </label>
                        <label class="flex-1 text-sm text-zinc-700">Max height
                            <span class="mt-1 flex items-center rounded-lg border border-zinc-500 bg-white focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-zinc-900">
                                <input id="height" type="number" min="1" inputmode="numeric" class="w-full min-w-0 bg-transparent px-3 py-2 text-zinc-900 outline-none">
                                <span class="pr-3 text-zinc-600">px</span>
                            </span>
                        </label>
                    </div>
                    <label class="mt-3 flex items-center gap-2 text-sm text-zinc-700">
                        <input id="no-enlarge" type="checkbox" checked class="tool-focus size-4 accent-zinc-900">
                        Don't enlarge smaller images
                    </label>
                </fieldset>

                <fieldset>
                    <legend class="text-sm font-semibold text-zinc-900">Format</legend>
                    <div class="mt-3 flex flex-wrap gap-2">
                        <label class="tool-choice cursor-pointer"><input type="radio" name="convert" value="keep" checked class="sr-only"><span class="inline-block rounded-full border border-zinc-500 px-3 py-1.5 text-sm text-zinc-900">Keep original</span></label>
                        <label class="tool-choice cursor-pointer"><input type="radio" name="convert" value="webp" class="sr-only"><span class="inline-block rounded-full border border-zinc-500 px-3 py-1.5 text-sm text-zinc-900">WebP</span></label>
                        <label class="tool-choice cursor-pointer"><input type="radio" name="convert" value="jpeg" class="sr-only"><span class="inline-block rounded-full border border-zinc-500 px-3 py-1.5 text-sm text-zinc-900">JPEG</span></label>
                        <label class="tool-choice cursor-pointer"><input type="radio" name="convert" value="png" class="sr-only"><span class="inline-block rounded-full border border-zinc-500 px-3 py-1.5 text-sm text-zinc-900">PNG</span></label>
                        <label class="tool-choice cursor-pointer"><input type="radio" name="convert" value="smallest" class="sr-only"><span class="inline-block rounded-full border border-zinc-500 px-3 py-1.5 text-sm text-zinc-900">Smallest</span></label>
                    </div>
                    <label id="fill-row" hidden class="mt-3 flex items-center gap-2 text-sm text-zinc-700">
                        <input id="fill" type="color" value="#ffffff" class="tool-focus h-8 w-10 cursor-pointer rounded border border-zinc-500 bg-white p-0.5">
                        Background for transparent images
                    </label>

                    <div class="mt-6" role="radiogroup" aria-labelledby="quality-label">
                        <p id="quality-label" class="text-sm font-semibold text-zinc-900">Quality</p>
                        <div class="mt-3 flex flex-wrap gap-2">
                            <label class="tool-choice cursor-pointer"><input type="radio" name="quality" value="smaller" class="sr-only"><span class="inline-block rounded-full border border-zinc-500 px-3 py-1.5 text-sm text-zinc-900">Smaller files</span></label>
                            <label class="tool-choice cursor-pointer"><input type="radio" name="quality" value="balanced" checked class="sr-only"><span class="inline-block rounded-full border border-zinc-500 px-3 py-1.5 text-sm text-zinc-900">Balanced</span></label>
                            <label class="tool-choice cursor-pointer"><input type="radio" name="quality" value="higher" class="sr-only"><span class="inline-block rounded-full border border-zinc-500 px-3 py-1.5 text-sm text-zinc-900">Higher quality</span></label>
                        </div>
                        <p class="mt-2 text-sm text-zinc-600">Use Higher quality for screenshots with small text.</p>
                    </div>
                </fieldset>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <button id="run" type="button" disabled class="tool-focus rounded-full bg-black px-5 py-2.5 text-sm font-medium text-white disabled:cursor-not-allowed disabled:border disabled:border-dashed disabled:border-zinc-500 disabled:bg-transparent disabled:text-zinc-600">Run</button>
                <button id="folder-instead" type="button" hidden class="tool-focus rounded text-sm text-zinc-800 underline underline-offset-2">Save to a folder instead</button>
                <button id="cancel" type="button" hidden class="tool-focus rounded-full border border-zinc-500 px-5 py-2.5 text-sm font-medium text-zinc-900 hover:bg-zinc-200">Cancel</button>
                <button id="zip" type="button" hidden class="tool-focus rounded-full bg-black px-5 py-2.5 text-sm font-medium text-white">Download</button>
                <p id="output-note" class="text-sm text-zinc-600" aria-live="polite"></p>
            </div>

            <div id="progress-wrap" hidden class="rounded-2xl bg-white p-6">
                <p id="progress-label" class="mb-2 text-sm text-zinc-700" aria-live="polite"></p>
                <progress id="progress" value="0" max="1" aria-label="Batch progress"></progress>
            </div>

            <div id="results" hidden class="rounded-2xl bg-white p-6">
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                    <p id="total-saved" class="font-display text-4xl font-bold text-zinc-900"></p>
                    <p class="text-zinc-700">saved · <span id="total-sizes" class="tabular-nums"></span> · <span id="total-count"></span></p>
                </div>
                <p id="compare-hint" hidden class="mt-2 text-sm text-zinc-600">Select an image's name to compare it with the original.</p>
                <div class="mt-4 overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="text-zinc-600">
                            <tr>
                                <th class="pb-2 pr-4 font-medium"><button type="button" data-sort="name" class="tool-focus rounded underline-offset-2 hover:underline">Name</button></th>
                                <th class="pb-2 pr-4 font-medium"><button type="button" data-sort="after" class="tool-focus rounded underline-offset-2 hover:underline">Before → after</button></th>
                                <th class="pb-2 pr-4 font-medium"><button type="button" data-sort="saved" class="tool-focus rounded underline-offset-2 hover:underline">Saved</button></th>
                                <th class="pb-2 pr-4 font-medium"><button type="button" data-sort="format" class="tool-focus rounded underline-offset-2 hover:underline">Format</button></th>
                                <th class="pb-2 font-medium">Notes</th>
                            </tr>
                        </thead>
                        <tbody id="rows" class="text-zinc-800"></tbody>
                    </table>
                </div>
            </div>

            <p class="text-sm text-zinc-600">Free software under the <a href="/tools/image-optimizer/LICENSE.txt" class="underline underline-offset-2">GPL-3.0 license</a>. <a href="https://github.com/JoosepN/MIO" class="underline underline-offset-2">Source code on GitHub</a>.</p>
        </div>
    </section>
</main>

<dialog id="overwrite" class="m-auto max-w-md rounded-2xl bg-white p-6 text-zinc-800">
    <form method="dialog">
        <h2 class="text-lg font-semibold text-zinc-900">Overwrite existing files?</h2>
        <p class="mt-2 text-sm">This folder already has files with the same names, like <span id="overwrite-example" class="break-all font-medium"></span>.</p>
        <div class="mt-5 flex justify-end gap-2">
            <button value="cancel" class="tool-focus rounded-full border border-zinc-500 px-4 py-2 text-sm font-medium text-zinc-900">Cancel</button>
            <button value="overwrite" class="tool-focus rounded-full bg-black px-4 py-2 text-sm font-medium text-white">Overwrite all</button>
        </div>
    </form>
</dialog>

<dialog id="compare" aria-labelledby="compare-title" class="m-auto rounded-2xl bg-white p-4 text-zinc-800">
    <div class="mb-3 flex items-center gap-3">
        <h2 id="compare-title" class="mr-auto min-w-0 break-all text-sm font-semibold text-zinc-900"></h2>
        <button id="compare-zoom" type="button" aria-pressed="false" class="tool-focus shrink-0 rounded-full border border-zinc-500 px-3 py-1.5 text-sm font-medium text-zinc-900">Full size</button>
        <form method="dialog" class="shrink-0"><button class="tool-focus rounded-full bg-black px-3 py-1.5 text-sm font-medium text-white">Close</button></form>
    </div>
    <div id="compare-frame" tabindex="0" role="group" aria-label="Before and after comparison" data-zoom="fit">
        <div id="compare-stage">
            <img id="compare-after" alt="Optimized image">
            <img id="compare-before" alt="Original image">
        </div>
        <div id="compare-handle" role="slider" tabindex="0" aria-label="Divider between original and optimized" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50"></div>
        <p id="compare-label-before" class="compare-label" style="left:10px"></p>
        <p id="compare-label-after" class="compare-label" style="right:10px"></p>
        <p id="compare-status" hidden></p>
    </div>
    <p id="compare-help" class="mt-2 text-sm text-zinc-600"></p>
</dialog>

<script type="module" src="/tools/image-optimizer/app/main.js"></script>
